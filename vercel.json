{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.9.0",
      "config": {
        "includeFiles": [
          "system/**",
          "application/**",
          "1/**",
          "assets/**",
          "vendor/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/1/(.*)", "dest": "/1/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
