{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.9.0",
      "config": { "maxLambdaSize": "300mb" }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
